<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 로컬 FastAPI는 HTTP를 사용한다. 에뮬레이터는 10.0.2.2, 실기기는 PC LAN IP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
