# 안드로이드 앱이 백엔드를 호출할 때 사용하는 키 (X-API-Key).
# OpenAI 키가 아닙니다. 배포 시 추측 불가능한 값으로 바꾸세요.
API_KEY=dev-api-key-change-me

# 백엔드만 OpenAI를 호출합니다. 이 키는 안드로이드 앱에 넣지 마세요.
OPENAI_API_KEY=

# https://platform.openai.com/docs/models 에서 사용 가능한 모델 ID로 설정하세요.
LLM_MODEL=gpt-5.6-terra

# 잡담/불필요 알림 1차 필터링 전용 모델 (LLM_MODEL보다 저렴한 모델 권장).
LLM_FILTER_MODEL=gpt-5.6-luna

# batch 처리가 자주 타임아웃되면 값을 올리세요.
LLM_TIMEOUT_SEC=30.0
